{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlverChat",
  "version": "0.1.2",
  "identifier": "com.alverchat.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AlverChat",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMTk2QkEzRkUwMzQ1QTAKUldTZ1JRUCtvMnNaaWl4ek5QUjNHMzRkWDNoT1haWTlWNzJCZmRLdU5TalRoMnFRMTV4UnRKRjAK",
      "endpoints": [
        "https://github.com/mhdanshadpm/AlverChat/releases/latest/download/latest.json"
      ]
    }
  }
}
