{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum window and event access for AlverChat windows",
  "windows": [
    "main",
    "dock",
    "compact",
    "menu"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:tray:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
